{
  "name": "Novagentica Board Pack",
  "nodes": [
    {
      "id": "5cb2b82b-88b5-4927-b1d1-df56e403bd52",
      "name": "1st of Month · 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [0, 0],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "months",
              "monthsInterval": 1,
              "triggerAtDayOfMonth": 1,
              "triggerAtHour": 9,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "be5d7d1a-f058-4c80-8a4c-bb7dbe213cfb",
      "name": "Fetch Board Pack PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [224, 96],
      "parameters": {
        "method": "POST",
        "url": "https://novaplanner-sable.vercel.app/api/board-pack",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      }
    },
    {
      "id": "41752c21-a9cb-4778-b5ba-3cf58db66eb4",
      "name": "Upload to Google Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [448, 96],
      "parameters": {
        "resource": "file",
        "operation": "upload",
        "inputDataFieldName": "data",
        "name": "=novagentica-board-pack-{{ $now.toFormat('yyyy-MM') }}.pdf",
        "folderId": {
          "__rl": true,
          "mode": "list",
          "value": "root",
          "cachedResultName": "/ (Root folder)"
        },
        "options": {
          "simplifyOutput": false
        }
      }
    },
    {
      "id": "87165b74-cdef-4c8b-a443-1322b1aac6c5",
      "name": "Email Board Pack Link",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [672, 96],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "shiv@novagentica.com",
        "subject": "=Novagentica Board Pack — {{ $now.toFormat('MMMM yyyy') }}",
        "emailType": "html",
        "message": "=<h2 style=\"font-family:sans-serif;color:#0f172a\">Monthly Board Pack</h2>\n<p style=\"font-family:sans-serif;color:#334155\">The latest Novagentica financial model has been generated and is ready to review.</p>\n<p style=\"margin:24px 0\"><a href=\"{{ $json.webViewLink }}\" style=\"background:#0f172a;color:#fff;padding:12px 20px;text-decoration:none;font-family:sans-serif;font-size:14px;border-radius:4px\">Open Board Pack →</a></p>\n<p style=\"font-family:sans-serif;font-size:12px;color:#94a3b8\">Generated {{ $now.toFormat('d MMMM yyyy') }} · Confidential · Internal use only</p>",
        "options": {
          "appendAttribution": false
        }
      },
      "webhookId": "4cd7cc00-57ef-45af-889c-7c11fa080d9d"
    },
    {
      "id": "5812cce4-828b-4943-991c-4351812d86a0",
      "name": "On-Demand Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 192],
      "parameters": {
        "httpMethod": "POST",
        "path": "board-pack-generate",
        "responseMode": "onReceived"
      },
      "webhookId": "8e99d7bf-a943-4c14-88a2-46d501adb9d2"
    }
  ],
  "connections": {
    "1st of Month · 09:00": {
      "main": [[{ "node": "Fetch Board Pack PDF", "type": "main", "index": 0 }]]
    },
    "Fetch Board Pack PDF": {
      "main": [[{ "node": "Upload to Google Drive", "type": "main", "index": 0 }]]
    },
    "Upload to Google Drive": {
      "main": [[{ "node": "Email Board Pack Link", "type": "main", "index": 0 }]]
    },
    "On-Demand Webhook": {
      "main": [[{ "node": "Fetch Board Pack PDF", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1", "availableInMCP": true },
  "meta": { "aiBuilderAssisted": true, "builderVariant": "mcp" },
  "description": "Monthly board pack automation: on the 1st of each month (or via webhook), fetches a PDF from the Novagentica planner API, uploads it to Google Drive, and emails a link to the recipient."
}
